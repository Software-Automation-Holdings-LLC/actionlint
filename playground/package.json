{
  "name": "actionlint-playground",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "rhysd <lin90162@yahoo.co.jp> (https://rhysd.github.io/)",
  "main": "main.js",
  "scripts": {
    "lint:stylelint": "stylelint style.css",
    "lint:prettier": "prettier --check *.ts *.mjs",
    "lint:eslint": "eslint --max-warnings 0 *.ts *.mjs",
    "lint:tsc-eslint": "tsc -p tsconfig.eslint.json",
    "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:stylelint && npm run lint:tsc-eslint",
    "prettier": "prettier --write *.ts *.mjs",
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "serve": "http-server . -p 1234",
    "start": "npm run serve",
    "test": "mocha ./test.js"
  },
  "overrides": {
    "undici": "7.30.1",
    "fast-uri": "3.1.9",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "glob": "14.0.2",
    "qs": "6.16.1",
    "postcss-selector-parser": "7.1.6",
    "serialize-javascript": "7.1.3",
    "source-map-js": "1.2.2",
    "js-yaml@^4": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "colord": "2.9.4",
    "diff": "8.0.3",
    "picomatch@^2": "2.3.2",
    "picomatch@^4": "4.0.4",
    "flatted": "3.4.2",
    "follow-redirects": "1.16.0",
    "@humanfs/node": "0.16.8",
    "ajv@^6": "6.14.0",
    "ajv@^8": "8.18.0"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "codemirror": "^5.65.21",
    "devicon": "^2.18.0",
    "ismobilejs": "^1.1.1",
    "pako": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@peculiar/webcrypto": "^1.7.2",
    "@types/codemirror": "^5.60.18",
    "@types/eslint-plugin-mocha": "^10.4.0",
    "@types/jsdom": "^27.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.9",
    "@types/pako": "^2.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-mocha": "^11.3.0",
    "http-server": "^14.1.1",
    "jsdom": "^28.1.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
